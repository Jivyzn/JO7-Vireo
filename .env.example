# Copy this file to .env, edit it, then export it with:
#   set -a; source .env; set +a

VIREO_VOSK_MODEL=./models/vosk-model-small-en-us-0.15
VIREO_HEF_MODEL=./models/yolov8m.hef
VIREO_DETECTION_SCRIPT=./scripts/run_object_detection.sh
VIREO_AUDIO_DIR=./assets/detection_audio
VIREO_AUDIO_CACHE=~/.cache/vireo/audio

# auto = try Coqui, otherwise use eSpeak; alternatives: coqui, espeak
VIREO_TTS_ENGINE=auto
VIREO_TTS_MODEL=tts_models/en/vctk/vits
VIREO_TTS_SPEAKER=p248
VIREO_PRECACHE=true

VIREO_CONFIDENCE=0.50
VIREO_ABSENCE_THRESHOLD=0.40
VIREO_DETECTION_SECONDS=15
VIREO_DETECTION_AUDIO=true
VIREO_ESPEAK_FALLBACK=true

VIREO_SERVO_PIN=17
VIREO_SERVO_MIN_ANGLE=0
VIREO_SERVO_MAX_ANGLE=180
VIREO_SERVO_CENTRE_OFFSET=-10

# Optional local assistant fallback.
VIREO_OLLAMA_MODEL=llama3
VIREO_OLLAMA_TIMEOUT=12
VIREO_OLLAMA_MAX_CHARS=280

# No GPS implementation is included in the current open-source release.
VIREO_LOCATION=

HAILO_EXAMPLES_DIR=~/hailo-rpi5-examples
